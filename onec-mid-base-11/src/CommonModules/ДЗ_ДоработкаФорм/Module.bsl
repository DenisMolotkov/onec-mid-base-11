#Область ПрограммныйИнтерфейс

// Добавляет поле контактного лица после договора в формах документов.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - создаваемая форма документа.
//
Процедура ПриСозданииНаСервере(Форма) Экспорт
	// Доработка_начало Молотков 06.11.2026, Нетология ДЗ 13-7. Поле контактного лица.
#Если Сервер Тогда

	ДорабатываемыеФормы = Новый Массив;
	ДорабатываемыеФормы.Добавить("Документ.ЗаказПокупателя.Форма.ФормаДокумента");
	ДорабатываемыеФормы.Добавить("Документ.ОплатаОтПокупателя.Форма.ФормаДокумента");
	ДорабатываемыеФормы.Добавить("Документ.ОплатаПоставщику.Форма.ФормаДокумента");
	ДорабатываемыеФормы.Добавить("Документ.ПоступлениеТоваровУслуг.Форма.ФормаДокумента");
	ДорабатываемыеФормы.Добавить("Документ.РеализацияТоваровУслуг.Форма.ФормаДокумента");

	Если ДорабатываемыеФормы.Найти(Форма.ИмяФормы) = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Форма.Элементы.Найти("КонтактноеЛицо") <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЭлементДоговор = Форма.Элементы.Найти("Договор");
	Если ЭлементДоговор = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Родитель = ЭлементДоговор.Родитель;

	ПолеКонтактноеЛицо = Форма.Элементы.Добавить(
		"КонтактноеЛицо", Тип("ПолеФормы"), Родитель);

	ПолеКонтактноеЛицо.Вид = ВидПоляФормы.ПолеВвода;
	ПолеКонтактноеЛицо.ПутьКДанным = "Объект.КонтактноеЛицо";
	ПолеКонтактноеЛицо.Заголовок = "Контактное лицо";

	// Находим элемент, перед которым разместим новое поле.
	СледующийЭлемент = Неопределено;
	НайденДоговор = Ложь;

	Для Каждого Элемент Из Родитель.ПодчиненныеЭлементы Цикл
		Если НайденДоговор И Элемент <> ПолеКонтактноеЛицо Тогда
			СледующийЭлемент = Элемент;
			Прервать;
		КонецЕсли;

		Если Элемент = ЭлементДоговор Тогда
			НайденДоговор = Истина;
		КонецЕсли;
	КонецЦикла;

	Если СледующийЭлемент <> Неопределено Тогда
		Форма.Элементы.Переместить(
			ПолеКонтактноеЛицо, Родитель, СледующийЭлемент);
	КонецЕсли;

#КонецЕсли
	// Доработка_конец Молотков 06.11.2026, Нетология ДЗ 13-7. Поле контактного лица.
КонецПроцедуры

#КонецОбласти