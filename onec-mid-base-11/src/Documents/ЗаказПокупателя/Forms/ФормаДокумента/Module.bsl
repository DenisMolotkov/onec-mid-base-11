#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура РассчитатьСуммуСтроки(ТекущиеДанные)
	
	// Доработка_начало Молотков 09.11.2026, Нетология ДЗ 13-7. Учет согласованной скидки в строке.
	// КоэффициентСкидки = 1 - ТекущиеДанные.Скидка / 100;
	СуммарнаяСкидка = Мин(100, ТекущиеДанные.Скидка + Объект.СогласованнаяСкидка);
	КоэффициентСкидки = 1 - СуммарнаяСкидка / 100;
	// Доработка_конец Молотков 09.11.2026, Нетология ДЗ 13-7. Учет согласованной скидки в строке.
	ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество * КоэффициентСкидки;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуДокумента()
	
	Объект.СуммаДокумента = Объект.Товары.Итог("Сумма") + Объект.Услуги.Итог("Сумма");
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьТабличныеЧастиСоСкидкой()
	// Доработка_начало Молотков 09.11.2026, Нетология ДЗ 13-7. Общий пересчет товаров и услуг.
	ТабличныеЧасти = Новый Массив;
	ТабличныеЧасти.Добавить(Объект.Товары);
	ТабличныеЧасти.Добавить(Объект.Услуги);

	Для Каждого ТабличнаяЧасть Из ТабличныеЧасти Цикл
		Для Каждого СтрокаТаблицы Из ТабличнаяЧасть Цикл
			РассчитатьСуммуСтроки(СтрокаТаблицы);
		КонецЦикла;
	КонецЦикла;

	РассчитатьСуммуДокумента();
	// Доработка_конец Молотков 09.11.2026, Нетология ДЗ 13-7. Общий пересчет товаров и услуг.
КонецПроцедуры

